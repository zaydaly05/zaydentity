# n8n webhook that receives CV files and returns a validated Portfolio JSON object.
N8N_CV_WEBHOOK_URL=

# Optional n8n webhook for AI actions from the editor.
N8N_AI_WEBHOOK_URL=

# Optional: URL opened by the Vercel deployment wizard. Defaults to Vercel Drop.
NEXT_PUBLIC_VERCEL_DEPLOY_URL=https://vercel.com/drop

# n8n webhook that receives {name,url} from the Deploy modal's "Register your
# live link" step and forwards a WhatsApp notification to the FolioForge team.
# Sent automatically in the background — disclosed to users in-app.
N8N_NOTIFY_WEBHOOK_URL=
